{
  "hosting": {
    "public": "static",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/movies",    "run": { "serviceId": "gomdb-api", "region": "us-central1" } },
      { "source": "/movies/**", "run": { "serviceId": "gomdb-api", "region": "us-central1" } },
      { "source": "/tvseries",  "run": { "serviceId": "gomdb-api", "region": "us-central1" } },
      { "source": "/people",    "run": { "serviceId": "gomdb-api", "region": "us-central1" } }
    ]
  }
}
